# SmileSync — copy these from Supabase Dashboard → Connect
# Then copy this file to `.env`

# -----------------------------------------------------------------------------
# Supabase (from Connect → Project URL + Publishable key)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Your email (SMTP) — booking + reminder emails are sent from this account
# Gmail: use an App Password (Google Account → Security → App passwords)
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SmileSync Dental Clinic"
NEXT_PUBLIC_SUPPORT_EMAIL="yourname@gmail.com"
CLINIC_ADDRESS="123 Dental Street, Healthcare City, HC 12345"
NEXT_PUBLIC_TIMEZONE="America/New_York"
TZ="America/New_York"

# Doctor inboxes (they receive booking + reminder emails)


# Reminders cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-any-random-string"
REMINDER_HOURS_BEFORE="24"
